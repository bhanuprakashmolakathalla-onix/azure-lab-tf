# Terraform working directories and plugin caches - large, machine-specific.
.terraform/
.terraform.tfstate.lock.info

# State must NEVER be committed. It contains resource ids, and for many
# providers it contains secrets in plaintext. Yours lives in Azure Blob with
# versioning and RBAC precisely so it is not here.
*.tfstate
*.tfstate.*

# Variable files may carry environment-specific values or credentials.
*.tfvars
*.tfvars.json
!example.tfvars

crash.log
crash.*.log

# NOTE what is deliberately NOT ignored:
#
#   .terraform.lock.hcl  - MUST be committed. It pins provider versions and
#                          checksums, and it is the only thing making a CI run
#                          reproduce what you ran locally.
#
#   */backend.tf         - generated by bootstrap-backend.ps1, and safe. It
#                          contains no key and no connection string, because the
#                          backend authenticates with Entra (use_azuread_auth).
